# Machine-specific: copy to data_manifest.toml and edit tier roots.
# LLM agents: add [datasets.<name>] BEFORE referencing logical_name in code.

[phases]
explore = "jsonl, pkl, xlsx, ad-hoc notebooks"
semi = "jsonl, markdown+yaml frontmatter"
frozen = "parquet (duckdb-queryable)"

[tiers.hot]
root = "/Users/you/develop"
mount_check = ""

[tiers.warm]
root = "/Volumes/your-warm-drive"
mount_check = "/Volumes/your-warm-drive"

[tiers.scratch]
root = "/Volumes/your-scratch-drive/scratch"
mount_check = "/Volumes/your-scratch-drive"

[tiers.cold]
root = "/Volumes/your-cold-archive"
mount_check = "/Volumes/your-cold-archive"

# --- datasets: one block per logical name ---

[datasets.example_input]
tier = "warm"
path = "datasets/corpus/raw_input.jsonl"
phase = "explore"
description = "Replace with your input dataset"
parent = ""

[datasets.example_output]
tier = "scratch"
path = "example_output.jsonl"
phase = "semi"
description = "Replace with your semi-structured output"
parent = "example_input"
